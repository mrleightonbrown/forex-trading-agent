# Copy to .env and fill in real values locally. Never commit .env.
#
# Required safety settings — must stay exactly these values in V1.
# See CLAUDE.md "Safety rules". App startup fails closed if these are wrong.
TRADING_MODE=PAPER
BROKER_ENVIRONMENT=PRACTICE
LIVE_TRADING_COMPILED=false

DATABASE_URL=postgresql+asyncpg://forex:forex@localhost:5432/forex_agent

# OANDA Practice API — https://developer.oanda.com/rest-live-v20/introduction/
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_API_BASE_URL=https://api-fxpractice.oanda.com
